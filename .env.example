# QuePass automation environment configuration.
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Application under test
BASE_URL=https://dev-quepass.cognetlabs.org

# Operator credentials entered in the workstation "Update Settings" dialog.
# These are the encoded values the app expects (not plaintext).
AUTH_EMAIL=
AUTH_PASSWORD=
CHANNEL=1

# Default event used by event check-in / registration scenarios.
DEFAULT_EVENT=Multiple Registeration - remote

# Fake webcam for unattended face capture (Chromium only). Path to a Y4M file.
# REQUIRED for the AI/platform tests (it activates the camera-injection layer).
# Build it once from the AI clip:
#   ffmpeg -i fixtures/media/ai_smile.mp4 -vf "scale=-2:960" -pix_fmt yuv420p -r 30 -an fixtures/media/face.y4m
FAKE_CAMERA_VIDEO=fixtures/media/face.y4m

# Timeouts (milliseconds)
API_TIMEOUT=60000
TEST_TIMEOUT=120000
